# ============================================================================
# 운영(prod) 환경변수 예시 — 실제 값은 .env.prod에 채우고 절대 커밋하지 않는다.
#
# 사용:
#   Copy-Item .env.prod.example .env.prod   (그 뒤 <채우세요>를 실제 값으로)
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ★ 모든 값이 필수다. 비우면 기동이 거부된다(${VAR:?} 문법).
# ★ DEV_ONLY_DO_NOT_USE_IN_PROD 마커가 든 값을 넣으면 앱이 시작을 거부한다.
# ============================================================================

POSTGRES_PASSWORD=<채우세요-운영-슈퍼유저-비밀번호>
KBOS_OWNER_PASSWORD=<채우세요-운영-owner-비밀번호>
KBOS_APP_PASSWORD=<채우세요-운영-app-비밀번호>

# 최소 32자, 임의의 긴 문자열. 예: openssl rand -hex 32
SECRET_KEY=<채우세요-32자-이상-임의문자열>

LOG_LEVEL=INFO
