#!/usr/bin/env bash
# 병합 차단 폴백(옵션 B) — push 전에 토큰체인 없이 즉시 도는 위생 검사.
#
# GitHub Pro가 없어 rulesets로 병합을 기계 차단할 수 없으므로(ADR-0011),
# 가장 흔한 사고(Windows CRLF·.env 커밋·시크릿 노출)만이라도 push 전에 막는다.
# 무거운 검사(테스트·타입·린트)는 CI가 하고, 병합은 scripts/merge-pr.sh가
# CI green 확인 후에만 한다.
#
# 활성화(1회):  git config core.hooksPath .githooks
set -euo pipefail

fail=0
note() { echo "  ✗ $1"; fail=1; }

# ① 인덱스에 CRLF/혼합 줄바꿈 파일이 없어야 한다.
if git ls-files --eol | grep -qE '^i/(crlf|mixed)'; then
  note "CRLF로 커밋된 파일이 있습니다. .gitattributes 확인 후 'git add --renormalize .'"
fi

# ② .env 실값 파일이 추적되면 안 된다.
if git ls-files | grep -qE '^\.env$|^\.env\.(dev|prod)$'; then
  note ".env 실값 파일이 추적되고 있습니다(.gitignore 확인)."
fi

# ③ 대소문자만 다른 파일명(Windows 충돌).
dups=$(git ls-files | tr 'A-Z' 'a-z' | sort | uniq -d || true)
if [ -n "$dups" ]; then
  note "대소문자만 다른 파일명: $dups"
fi

# ④ API 키/토큰 패턴 (테스트 픽스처·마스킹 구현은 제외).
if git grep -nE 'sk-ant-[A-Za-z0-9]{12}|ghp_[A-Za-z0-9]{20}|gho_[A-Za-z0-9]{20}' -- . \
     ':!*.yml' ':!backend/tests' ':!backend/app/core/logging/redaction.py' ':!.githooks' >/dev/null 2>&1; then
  note "API 키/토큰으로 보이는 문자열이 있습니다."
fi

# ⑤ backend 포맷 (ruff format --check) — 같은 실수 3회 차단(PR #10 2회·PR #12 1회):
#    포맷 누락 push → CI backend 잡 실패 → 포맷 전용 정정 커밋이 반복됐다. push 전에 막는다.
#    호스트 ruff는 requirements-dev.txt 고정판과 버전이 같을 때만 신뢰(포맷 규칙이 버전에
#    따라 달라 드리프트가 곧 오탐·누락이다). 아니면 api 이미지(고정판 설치본)로 검사하고,
#    수단이 없으면 실패한다(fail-closed — 검사 없이 통과시키지 않는다).
ruff_pin=$(grep -oE '^ruff==[0-9][0-9.]*' backend/requirements-dev.txt | head -n1 | cut -d= -f3 || true)
if command -v ruff >/dev/null 2>&1 && [ -n "$ruff_pin" ] \
   && [ "$(ruff --version 2>/dev/null | awk '{print $2}')" = "$ruff_pin" ]; then
  if ! (cd backend && ruff format --check .); then
    note "backend 포맷이 ruff format과 다릅니다 — 'cd backend && ruff format .' 후 커밋하세요."
  fi
elif docker info >/dev/null 2>&1; then
  if ! docker compose run --rm --no-deps -T api ruff format --check .; then
    note "backend 포맷이 ruff format과 다릅니다(api 이미지 검사) — 'docker compose run --rm --no-deps api ruff format .' 후 커밋하세요."
  fi
else
  note "ruff format 검사 수단이 없습니다 — 'pip install ruff==${ruff_pin:-<requirements-dev.txt 참조>}' 또는 docker 기동 후 다시 push하세요."
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "  push를 중단했습니다. 위 항목을 고치고 다시 push하세요."
  echo "  (정말 우회해야 하면: git push --no-verify — 권장하지 않음)"
  exit 1
fi

echo "  ✓ pre-push 위생 검사 통과"
