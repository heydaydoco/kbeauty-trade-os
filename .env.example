# ============================================================================
# 개발(dev) 환경변수 예시
#
# 사용법 (PowerShell):
#     Copy-Item .env.example .env
#
# ★ Set-Content / Out-File / > 로 만들지 말 것.
#   Windows PowerShell 5.1의 기본 인코딩은 ANSI 또는 UTF-16LE이고,
#   그렇게 만든 .env는 Docker Compose가 키를 하나도 읽지 못한다.
#   Copy-Item은 바이트 그대로 복사하므로 안전하다.
#
# 이 파일(.env.example)은 커밋되지만 실제 값이 든 .env는 절대 커밋되지 않는다
# (.gitignore, DESIGN.md §18.2).
# ============================================================================

# ── DB 비밀번호 ─────────────────────────────────────────────────────────────
# DEV_ONLY_DO_NOT_USE_IN_PROD 마커가 들어 있는 값으로 운영 기동을 시도하면
# 애플리케이션이 시작을 거부한다(예시 시크릿이 운영에 새는 최빈 사고 차단).

# PostgreSQL 슈퍼유저 — 컨테이너 초기화와 부트스트랩에만 쓰인다.
POSTGRES_PASSWORD=DEV_ONLY_DO_NOT_USE_IN_PROD_postgres

# kbos_owner — 스키마 소유자. alembic 마이그레이션 전용 (DDL 가능).
KBOS_OWNER_PASSWORD=DEV_ONLY_DO_NOT_USE_IN_PROD_owner

# kbos_app — 런타임 계정. 테이블을 만들 수 없다 (DESIGN.md §17.5 / ADR-0002).
KBOS_APP_PASSWORD=DEV_ONLY_DO_NOT_USE_IN_PROD_app
